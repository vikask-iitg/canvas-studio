{
  "name": "canvas-studio",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:start": "npm run db:start -w @canvas/api",
    "db:migrate": "npm run db:migrate -w @canvas/api",
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @canvas/api\" \"npm run dev -w @canvas/web\"",
    "build": "npm run build -w @canvas/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true,
    "@embedded-postgres/darwin-arm64@18.4.0-beta.17": true,
    "fsevents@2.3.3": true,
    "core-js": false
  }
}
