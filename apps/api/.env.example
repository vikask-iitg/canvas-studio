# Postgres. `npm run db:start` launches an embedded Postgres on this URL for local dev.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/canvas_studio
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5433/canvas_studio

PORT=4000
WEB_URL=http://localhost:5173
# Comma-separated CORS allowlist (defaults to WEB_URL)
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
# lax for same-site deploys, none when web and API are on different sites (requires HTTPS)
COOKIE_SAMESITE=lax

# Vercel Blob (used when S3 is not configured; set automatically by a connected Blob store)
BLOB_READ_WRITE_TOKEN=
# Shared secret Vercel Cron sends to /api/v1/cron/purge-trash
CRON_SECRET=

# S3 / R2 (optional — falls back to local disk under ./uploads when unset)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
